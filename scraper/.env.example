# TMDB credentials. You only need ONE of the two below.
# Get them at https://www.themoviedb.org/settings/api

# Option A: classic v3 API key (a 32-char hex string)
TMDB_API_KEY=

# Option B: v4 read access token (a long JWT starting with "eyJ..."). If set,
# this takes precedence over TMDB_API_KEY.
TMDB_READ_TOKEN=

# Optional: your Letterboxd username (only used to auto-detect export folders
# named letterboxd-<username>-...). Leave blank to auto-pick the newest export.
LETTERBOXD_USERNAME=
